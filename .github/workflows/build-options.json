{
  "os": [
    "ubuntu-latest",
    "windows-latest",
    "macos-latest"
  ],
  "unity-version": [
    "6000.0.x",
    "6000.1.*",
    "6000.2",
    "6000.3",
    "6000.4",
    "6000.5",
    "6000.6",
    "6000.7",
    "7000.0"
  ],
  "include": [
    {
      "os": "ubuntu-latest",
      "unity-version": "none"
    },
    {
      "os": "ubuntu-latest",
      "build-target": "StandaloneLinux64"
    },
    {
      "os": "ubuntu-latest",
      "build-target": "WebGL",
      "build-args": "-colorSpace Gamma"
    },
    {
      "os": "ubuntu-latest",
      "build-target": "Android"
    },
    {
      "os": "windows-latest",
      "unity-version": "none"
    },
    {
      "os": "windows-11-arm",
      "unity-version": "none"
    },
    {
      "os": "windows-latest",
      "build-target": "StandaloneWindows64"
    },
    {
      "os": "macos-latest",
      "unity-version": "none"
    },
    {
      "os": "windows-latest",
      "build-target": "Android"
    },
    {
      "os": "macos-latest",
      "build-target": "StandaloneOSX"
    },
    {
      "os": "macos-latest",
      "build-target": "iOS"
    }
  ]
}
